<?xml version="1.0" encoding="utf-8"?>
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="sharedpref" path="secure_session.xml" />
        <exclude domain="database" path="sonnet.db" />
        <exclude domain="database" path="sonnet.db-wal" />
        <exclude domain="database" path="sonnet.db-shm" />
        <exclude domain="database" path="sonnet.db-journal" />
